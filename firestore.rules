rules_version = '2';

/* =====================================================================
   Firestore security rules for dance-calendar-d733f.

   Neither Master Booker app talks to Firestore from the browser. The
   client site and the coach panel go through Netlify functions, which
   use the Admin SDK and bypass these rules entirely. So every collection
   Master Booker owns is closed here — not restricted, closed.

   That matters most for `clients`, which holds phone numbers and session
   tokens. Nothing in a browser can read it at any price.

   What is left open is the calendar app's own data, and only because
   that app writes to Firestore directly with no sign-in at all. Locking
   `lessons` down today stops the coach entering a lesson by hand.

   ---------------------------------------------------------------------
   TO CLOSE THE REMAINING HOLE

     1. Add Firebase Auth sign-in to the calendar app (petarCalendar).
     2. Put the coach's address in isCoach() below.
     3. Swap the `allow read, write: if true` blocks for `if isCoach()`.

   Until step 1, `lessons` and `repeat_exceptions` are world-writable.
   That is the status quo, not a regression — but it is the one thing
   worth fixing next.
   ===================================================================== */

service cloud.firestore {
  match /databases/{database}/documents {

    function isCoach() {
      return request.auth != null && request.auth.token.email in [
        "REPLACE-WITH-COACH@example.com"
      ];
    }

    /* ---- the calendar app's collections ----
       Open because petarCalendar has no sign-in yet. See above. */
    match /lessons/{id} {
      allow read, write: if true;
    }

    match /repeat_exceptions/{id} {
      allow read, write: if true;
    }

    match /students/{id} {
      allow read, write: if true;
    }

    /* ---- Master Booker's collections ----
       Reached only through the Netlify functions, which use the Admin
       SDK. No browser has any business here.

         clients        names, phone numbers, session tokens
         day_index      derived; only the rebuild writes it
         availability   the coach's hours
         booking_log    cancellation history the statistics depend on
         requests       late cancellations awaiting the coach
         notifications  the "to tell" queue
    */
    match /clients/{id}       { allow read, write: if false; }
    match /day_index/{date}   { allow read, write: if false; }
    match /availability/{id}  { allow read, write: if false; }
    match /booking_log/{id}   { allow read, write: if false; }
    match /requests/{id}      { allow read, write: if false; }
    match /notifications/{id} { allow read, write: if false; }

    /* Anything not named above is closed. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
