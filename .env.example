# Local development does NOT need this file: drop the downloaded service
# account JSON in as serviceAccountKey.json (gitignored) and the admin
# loader picks it up. Set FIREBASE_KEY_FILE to use a different path.
#
# Firebase Admin service account — Netlify environment variables only.
# NEVER commit the real values; a leaked key is full database write access.
#
# Create at: Firebase console -> Project settings -> Service accounts ->
# "Generate new private key". Then paste the three fields below.
FIREBASE_PROJECT_ID=dance-calendar-d733f
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@dance-calendar-d733f.iam.gserviceaccount.com
# Keep the literal \n escapes from the JSON file — the loader converts them.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"

# The coach panel's passcode. Clients need nothing — they sign in with
# their name and phone number — but the panel shows every client's real
# name and can cancel any lesson, so it is gated.
#
# If this is unset, every coach endpoint refuses. An absent passcode must
# never mean "let anyone in".
COACH_PASSCODE=change-me

# Lets the calendar app trigger an index rebuild after it saves a lesson.
# Low privilege on purpose: it can only recompute derived data, so it is
# safe to embed in that app's browser-visible JavaScript. Never reuse the
# coach passcode here.
REBUILD_TOKEN=change-me-too
